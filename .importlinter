[importlinter]
root_packages =
    tg_agent
include_external_packages = True

# The legacy UI surfaces (the tg-webui web panel and the tg-tui agent chat) were
# removed in #1868. These contracts keep the core from ever importing them
# again, even when such a package happens to be installed.

[importlinter:contract:runtime_no_web_imports]
name = Core does not import the removed web panel package (#1868)
type = forbidden
source_modules =
    tg_agent
forbidden_modules =
    tg_webui
allow_indirect_imports = True

[importlinter:contract:telegram_actions_no_raw_telethon_functions_in_entrypoints]
name = Telegram entrypoints do not import Telethon directly outside allowed pipeline errors
type = forbidden
source_modules =
    tg_agent.cli
    tg_agent.agent.tools
    tg_agent.services.pipeline_nodes
    tg_agent.services.telegram_command_dispatcher
forbidden_modules =
    telethon
allow_indirect_imports = True
ignore_imports =
    tg_agent.services.pipeline_nodes.handlers -> telethon
    tg_agent.services.telegram_command_dispatcher -> telethon

[importlinter:contract:core_no_tui_imports]
name = Core does not import the agent-chat TUI package (removed with the embedded chat, #1868)
type = forbidden
source_modules =
    tg_agent
forbidden_modules =
    tg_tui
allow_indirect_imports = True
