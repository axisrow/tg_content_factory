# Telegram API credentials (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=

# Web panel password (required). Pick a strong, unique value — `serve` will
# refuse to start with a weak/empty password if web.host is not loopback.
WEB_PASS=

# Web panel bind address override (optional). config.yaml defaults to
# 127.0.0.1 (#1303); docker-compose.yml sets this to 0.0.0.0 for you so the
# published port is reachable. Leave empty for native (non-Docker) runs.
WEB_HOST=

# Key for encrypting Telegram session strings in DB (enc:v2)
SESSION_ENCRYPTION_KEY=

# LLM for AI search (optional)
LLM_API_KEY=

# AI Agent — Claude API key and OAuth token
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# AI Agent model override (optional, default: anthropic:claude-sonnet-4-6)
AGENT_MODEL=

# PyPI publishing (used by scripts/release_pypi.sh)
TWINE_USERNAME=__token__
TEST_PYPI_TOKEN=pypi-...
PYPI_TOKEN=pypi-...
